{
  "entities": {
    "users": {
      "title": "users",
      "description": "Perfiles de usuarios con asignación de roles (aficionado, admin, taquilla, concesionario, runner)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["aficionado", "admin", "taquilla", "concesionario", "runner"] },
        "photoURL": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "standId": { "type": "string" },
        "standName": { "type": "string" },
        "assignedZone": { "type": "string" },
        "runnerStatus": { "type": "string", "enum": ["disponible", "en_entrega", "inactivo"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "tickets": {
      "title": "tickets",
      "description": "Boletos para partidos del estadio de béisbol con código QR y validación de taquilla",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "matchTitle": { "type": "string" },
        "matchDate": { "type": "string" },
        "stadium": { "type": "string" },
        "section": { "type": "string" },
        "row": { "type": "string" },
        "seat": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["activo", "usado", "cancelado"] },
        "qrId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "section", "row", "seat", "status", "qrId"]
    },
    "memberships": {
      "title": "memberships",
      "description": "Abonos y membresías de Socio Venados",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "memberNumber": { "type": "string" },
        "tier": { "type": "string", "enum": ["General", "Oro", "Platino", "Diamante"] },
        "status": { "type": "string", "enum": ["activa", "vencida", "suspendida"] },
        "renewalDate": { "type": "string" },
        "startDate": { "type": "string" },
        "seatAssigned": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "memberNumber", "tier", "status", "renewalDate"]
    },
    "inventory": {
      "title": "inventory",
      "description": "Control de stock de mercancía oficial de tienda y almacén de Venados",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["sku", "name", "price", "stock"]
    },
    "merchOrders": {
      "title": "merchOrders",
      "description": "Logística de despacho, paquetería y pedidos de tienda",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "total": { "type": "number" },
        "shippingType": { "type": "string", "enum": ["domicilio", "tienda"] },
        "carrier": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["pendiente", "empacado", "en_transito", "entregado", "cancelado"] },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "customerName", "total", "status"]
    },
    "stands": {
      "title": "stands",
      "description": "Puestos, locales y concesiones comerciales dentro del estadio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "categoryTag": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string" },
        "commissionRate": { "type": "number" },
        "active": { "type": "boolean" },
        "image": { "type": "string" },
        "estimatedWaitMinutes": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "location", "active"]
    },
    "menuItems": {
      "title": "menuItems",
      "description": "Menú de platillos, bebidas y snacks por concesión",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "standId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "available": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["standId", "name", "price", "available"]
    },
    "foodOrders": {
      "title": "foodOrders",
      "description": "Pedidos express de comida en estadio con código de retiro",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "standId": { "type": "string" },
        "standName": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "pickupCode": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pendiente", "preparando", "listo", "entregado", "cancelado"] },
        "createdAt": { "type": "string" }
      },
      "required": ["standId", "userId", "pickupCode", "total", "status"]
    },
    "sales": {
      "title": "sales",
      "description": "Registro consolidado de ventas de boletos, mercancía y alimentos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channel": { "type": "string", "enum": ["boletos", "tienda_merch", "concesion_alimentos"] },
        "referenceId": { "type": "string" },
        "customerName": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["channel", "amount", "date", "status"]
    },
    "venues": {
      "title": "venues",
      "description": "Recintos deportivos o de entretenimiento",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "address": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "city", "state", "address", "active"]
    },
    "venueEvents": {
      "title": "venueEvents",
      "description": "Eventos por recinto (partidos, conciertos, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "venueId": { "type": "string" },
        "type": { "type": "string", "enum": ["baseball", "football", "basketball", "concert", "other"] },
        "name": { "type": "string" },
        "date": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["venueId", "type", "name", "date", "active"]
    },
    "seatSections": {
      "title": "seatSections",
      "description": "Mapa físico de secciones y capacidad de butacas por sede deportiva",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "venueId": { "type": "string" },
        "sectionNumber": { "type": "string" },
        "zoneName": { "type": "string" },
        "totalSeats": { "type": "number" },
        "rows": { "type": "number" },
        "seatsPerRow": { "type": "number" }
      },
      "required": ["venueId", "sectionNumber", "zoneName", "totalSeats", "rows", "seatsPerRow"]
    },
    "eventSeats": {
      "title": "eventSeats",
      "description": "Disponibilidad y estado de cada butaca por evento programado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "sectionId": { "type": "string" },
        "rowLabel": { "type": "string" },
        "seatNumber": { "type": "number" },
        "status": { "type": "string", "enum": ["disponible", "vendido"] },
        "ticketId": { "type": "string" },
        "purchaseId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["eventId", "sectionId", "rowLabel", "seatNumber", "status"]
    }
  }
}
