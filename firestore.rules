rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers de Autenticación y Roles
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().data.get('role', 'aficionado') == role
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['jorgeandres980706@gmail.com', 'andreaszchy98@gmail.com'] ||
        hasRole('admin')
      );
    }
    
    function isTaquilla() {
      return hasRole('taquilla') || isAdmin();
    }

    function isConcesionario() {
      return hasRole('concesionario') || isAdmin();
    }

    function isRunner() {
      return hasRole('runner') || isAdmin();
    }

    function isStandOwnerOrAssigned(standId) {
      return isAdmin() || (
        isConcesionario() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           getUserDoc().data.get('standId', '') == standId) ||
          (exists(/databases/$(database)/documents/stands/$(standId)) &&
           get(/databases/$(database)/documents/stands/$(standId)).data.get('ownerId', '') == request.auth.uid)
        )
      );
    }

    // 1. Usuarios y Perfiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Boletos y Entradas
    match /tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isTaquilla() || isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }

    // 3. Membresías (Socio Venados)
    match /memberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 4. Inventario de Tienda y Almacén
    match /inventory/{productId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated();
      match /cost/{document} {
        allow read, write: if isAdmin();
      }
    }

    // 5. Pedidos de Mercancía y Logística
    match /merchOrders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isRunner() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 6. Concesiones / Puestos de Comida en Estadio
    match /stands/{standId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isConcesionario();
      allow update: if isAdmin() || isConcesionario();
      allow delete: if isAdmin();
    }

    // 7. Menú de Alimentos y Bebidas
    match /menuItems/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isConcesionario();
    }

    // 8. Zonas del Estadio
    match /zones/{zoneId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 9. Pedidos de Comida / Pickup Express & In-Seat
    match /foodOrders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isConcesionario() ||
        isRunner() ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 10. Auditoría y Registro de Ventas
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
