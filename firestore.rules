rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers de Autenticación y Roles
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().data.role == role
      );
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isTaquilla() {
      return hasRole('taquilla') || isAdmin();
    }

    function isConcesionario() {
      return hasRole('concesionario') || isAdmin();
    }

    function isStandOwnerOrAssigned(standId) {
      return isAdmin() || (
        isConcesionario() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           getUserDoc().data.standId == standId) ||
          (exists(/databases/$(database)/documents/stands/$(standId)) &&
           get(/databases/$(database)/documents/stands/$(standId)).data.ownerId == request.auth.uid)
        )
      );
    }

    // 1. Usuarios y Perfiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Boletos y Entradas
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isTaquilla());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isTaquilla());
      allow update: if isTaquilla() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 3. Membresías (Socio Venados)
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || isTaquilla());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Inventario de Tienda y Almacén
    match /inventory/{productId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      match /cost/{document} {
        allow read, write: if isAdmin();
      }
    }

    // 5. Pedidos de Mercancía y Logística
    match /merchOrders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pendiente' &&
        request.resource.data.status == 'cancelado' &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.carrier == resource.data.carrier &&
        request.resource.data.trackingNumber == resource.data.trackingNumber
      );
      allow delete: if isAdmin();
    }

    // 6. Concesiones / Puestos de Comida en Estadio
    match /stands/{standId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isConcesionario() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || (
        isConcesionario() && (
          resource.data.ownerId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           getUserDoc().data.standId == standId)
        )
      );
      allow delete: if isAdmin();
    }

    // 7. Menú de Alimentos y Bebidas
    match /menuItems/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isConcesionario() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().data.standId == request.resource.data.standId
      );
      allow update, delete: if isAdmin() || (
        isConcesionario() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().data.standId == resource.data.standId
      );
    }

    // 8. Pedidos de Comida / Pickup Express
    match /foodOrders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isStandOwnerOrAssigned(resource.data.standId)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isStandOwnerOrAssigned(resource.data.standId) || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pendiente' &&
        request.resource.data.status == 'cancelado' &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.pickupCode == resource.data.pickupCode &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin();
    }

    // 9. Auditoría y Registro de Ventas
    match /sales/{saleId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isTaquilla() || isConcesionario();
      allow update, delete: if isAdmin();
    }
  }
}
