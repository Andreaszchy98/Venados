rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers de Autenticación y Roles
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().data.get('role', 'aficionado') == role
      );
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().data.get('role', 'aficionado') == 'superadmin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().data.get('role', 'aficionado') == 'admin'
      );
    }

    function isVenueAdmin(venueId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            getUserDoc().data.get('role', 'aficionado') == 'admin' ||
            getUserDoc().data.get('role', 'aficionado') == 'superadmin'
          ) && (
            getUserDoc().data.get('venueId', 'venue-teodoro-mariscal') == (venueId != null && venueId != '' ? venueId : 'venue-teodoro-mariscal') ||
            getUserDoc().data.get('venueId', '') == '' ||
            getUserDoc().data.get('venueId', '') == 'all'
          )
        )
      );
    }
    
    function isTaquilla() {
      return hasRole('taquilla');
    }

    function isConcesionario() {
      return hasRole('concesionario');
    }

    function isRunner() {
      return hasRole('runner');
    }

    function isStandOwnerOrAssigned(standId) {
      return isConcesionario() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().data.get('standId', '') == standId) ||
        (exists(/databases/$(database)/documents/stands/$(standId)) &&
         get(/databases/$(database)/documents/stands/$(standId)).data.get('ownerId', '') == request.auth.uid)
      );
    }

    // 1. Usuarios y Perfiles
    // superadmin o admin puede actualizar usuarios (para gestión de roles/personal)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // 2. Boletos y Entradas (Scoped por recinto)
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        isTaquilla() ||
        isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'))
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid ||
        isTaquilla() ||
        isVenueAdmin(request.resource.data.get('venueId', 'venue-teodoro-mariscal'))
      );
      allow update: if isAdmin() || isTaquilla() || (isAuthenticated() && resource.data.userId == request.auth.uid) || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'));
      allow delete: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'));
    }

    // 3. Membresías (Socio Venados)
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal')) ||
        isTaquilla()
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid ||
        isVenueAdmin(request.resource.data.get('venueId', 'venue-teodoro-mariscal'))
      );
      allow update, delete: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'));
    }

    // 4. Inventario de Tienda y Almacén (Scoped por recinto)
    match /inventory/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isVenueAdmin(request.resource.data.get('venueId', 'venue-teodoro-mariscal'));
      allow update, delete: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'));
      match /cost/{document} {
        allow read, write: if isAdmin() || isVenueAdmin(get(/databases/$(database)/documents/inventory/$(productId)).data.get('venueId', 'venue-teodoro-mariscal'));
      }
    }

    // 5. Pedidos de Mercancía y Logística (Scoped por recinto)
    match /merchOrders/{orderId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal')) ||
        isRunner()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal')) || isRunner() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pendiente' &&
        request.resource.data.status == 'cancelado' &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.carrier == resource.data.carrier &&
        request.resource.data.trackingNumber == resource.data.trackingNumber
      );
      allow delete: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'));
    }

    // 6. Concesiones / Puestos de Comida en Estadio (Scoped por recinto)
    match /stands/{standId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isVenueAdmin(request.resource.data.get('venueId', 'venue-teodoro-mariscal')) || (isConcesionario() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal')) || (
        isConcesionario() && (
          resource.data.ownerId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           getUserDoc().data.get('standId', '') == standId)
        )
      );
      allow delete: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'));
    }

    // 7. Menú de Alimentos y Bebidas (Scoped por puesto y recinto)
    match /menuItems/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal')) || isStandOwnerOrAssigned(request.resource.data.standId);
    }

    // 8. Zonas del Estadio (Scoped por recinto)
    match /zones/{zoneId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'));
    }

    // 9. Pedidos de Comida / Pickup Express & In-Seat (Scoped por puesto, zona y recinto)
    match /foodOrders/{orderId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow update: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal')) || (
        // Concesionario del stand:
        // Solo puede avanzar a 'preparando' o 'listo'.
        // En pedidos pickup también puede avanzar a 'entregado' al retirar el aficionado.
        // En pedidos in-seat NO puede poner 'en-camino' ni 'entregado'.
        isStandOwnerOrAssigned(resource.data.standId) && (
          (request.resource.data.status in ['preparando', 'listo']) ||
          (resource.data.orderType == 'pickup' && request.resource.data.status == 'entregado')
        ) &&
        request.resource.data.standId == resource.data.standId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.orderType == resource.data.orderType
      ) || (
        // Runner:
        // Solo puede actualizar pedidos in-seat de su propia zona asignada
        isRunner() &&
        resource.data.orderType == 'in-seat' &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          getUserDoc().data.get('zoneId', '') == '' ||
          getUserDoc().data.get('zoneId', '') == resource.data.zoneId
        ) && (
          // Caso A: Tomar pedido disponible en su zona ('listo' sin runner -> 'en-camino' con runnerId = request.auth.uid)
          (
            resource.data.status == 'listo' &&
            (resource.data.runnerId == null || resource.data.runnerId == '') &&
            request.resource.data.status == 'en-camino' &&
            request.resource.data.runnerId == request.auth.uid
          ) ||
          // Caso B: Marcar como entregado en butaca ('en-camino' -> 'entregado' para su propio runnerId)
          (
            resource.data.status == 'en-camino' &&
            resource.data.runnerId == request.auth.uid &&
            request.resource.data.status == 'entregado' &&
            request.resource.data.runnerId == request.auth.uid
          )
        ) &&
        request.resource.data.standId == resource.data.standId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.orderType == resource.data.orderType
      ) || (
        // Aficionado dueño del pedido: solo puede cancelar si está 'pendiente'
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pendiente' &&
        request.resource.data.status == 'cancelado' &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.pickupCode == resource.data.pickupCode &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.orderType == resource.data.orderType
      );

      allow delete: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'));
    }

    // 10. Auditoría y Registro de Ventas (Scoped por recinto)
    match /sales/{saleId} {
      allow read: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'));
      allow create: if isVenueAdmin(request.resource.data.get('venueId', 'venue-teodoro-mariscal')) ||
        isTaquilla() || isConcesionario() || (
          isAuthenticated() &&
          request.resource.data.get('channel', '') == 'boletos' &&
          request.resource.data.get('userId', '') == request.auth.uid
        );
      allow update, delete: if isAdmin() || isVenueAdmin(resource.data.get('venueId', 'venue-teodoro-mariscal'));
    }

    // 11. Recintos (Venues - Lectura pública para información de sedes en cartelera previa al login, administración de Superadmin y Admin de Sede)
    match /venues/{venueId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isVenueAdmin(venueId) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // 12. Eventos por Recinto (Venue Events - Scoped por Admin de Sede, lectura pública para cartelera previa al login)
    match /venueEvents/{eventId} {
      allow read: if true;
      allow create: if isVenueAdmin(request.resource.data.venueId);
      allow update, delete: if isVenueAdmin(resource.data.venueId);
    }

    // 13. Secciones del mapa físico de la sede
    match /seatSections/{sectionId} {
      allow read: if isAuthenticated();
      allow create: if isVenueAdmin(request.resource.data.venueId);
      allow update: if isVenueAdmin(resource.data.venueId);
      allow delete: if isVenueAdmin(resource.data.venueId);
    }

    // 14. Asientos y disponibilidad por evento
    match /eventSeats/{seatId} {
      allow read: if isAuthenticated();
      allow create: if isVenueAdmin(get(/databases/$(database)/documents/venueEvents/$(request.resource.data.eventId)).data.venueId);
      allow update: if isAuthenticated()
        && resource.data.status == 'disponible'
        && request.resource.data.status == 'vendido'
        && request.resource.data.ticketId is string;
      allow delete: if isVenueAdmin(get(/databases/$(database)/documents/venueEvents/$(resource.data.eventId)).data.venueId);
    }

    // 15. Verificación de conectividad Firestore
    match /test/{docId} {
      allow read: if true;
    }
  }
}

